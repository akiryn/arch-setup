layout{
    focus-ring{
        active-gradient from="#c1c4ebE6" to="#86d1eaE6" angle=135
        urgent-color "#ffb4ab"

        }
}
recent-windows {
    highlight {
        active-color "#343a3c"
        urgent-color "#ffb4ab"
    }
}
// 内置screencast portal选择器的配色
/- screen-cast-picker {
    background-color "#1b2023"
    accent-color "#86d1ea"
    text-color "#dee3e6"
    accent-text-color "#003642"
}
/- grid-overview {
    minimized-highlight {
        // off
        color "#b3cad380"
        urgent-color "#86d1ea80"
    }
}
