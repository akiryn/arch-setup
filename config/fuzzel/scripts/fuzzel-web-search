#!/usr/bin/env bash

# 域名每段 1～63 个字符，首尾不能是连字符
DOMAIN_LABEL='[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?'
DOMAIN="(${DOMAIN_LABEL}\.)+[a-zA-Z]{2,63}"

# IPv4 每段为 0～255，不接受多位数字的前导零
IPV4_OCTET='(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])'
IPV4="(${IPV4_OCTET}\.){3}${IPV4_OCTET}"
SCHEME='[hH][tT][tT][pP][sS]?://'
GOOGLE_SEARCH_URL='https://www.google.com/search?q='

prepare_web_url() {
    local input=$1 scheme host port default_scheme=https
    # 提取协议、主机和端口。IPv6 的端口位于方括号之后。
    local url_pattern="^(${SCHEME})?"'(\[[0-9A-Fa-f:.]+\]|[A-Za-z0-9.-]+)(:([1-9][0-9]{0,4}))?([/?#].*)?$'

    [[ $input != *[[:space:][:cntrl:]]* ]] || return 1
    case $input in
        *\\*|*\"*|*\<*|*\>*) return 1 ;;
    esac
    [[ $input =~ $url_pattern ]] || return 1
    scheme=${BASH_REMATCH[1]}
    host=${BASH_REMATCH[2]}
    port=${BASH_REMATCH[4]}

    if [[ -n $port ]] && (( 10#$port > 65535 )); then
        return 1
    fi

    if [[ $host == \[*\] ]]; then
        # 只有 IPv6 候选需要启动 Python 进行地址校验。
        command -v python3 >/dev/null 2>&1 || return 1
        default_scheme=$(python3 -c '
import ipaddress
import sys

address = ipaddress.IPv6Address(sys.argv[1])
print("http" if address.is_loopback else "https")
' "${host:1:${#host}-2}" 2>/dev/null) || return 1
    elif [[ ${host,,} == localhost ]]; then
        default_scheme=http
    elif [[ $host =~ ^${IPV4}$ ]]; then
        if [[ $host == 127.* ]]; then
            default_scheme=http
        fi
    else
        (( ${#host} <= 253 )) && [[ $host =~ ^${DOMAIN}$ ]] || return 1
    fi

    TARGET_URL=$input
    if [[ -z $scheme ]]; then
        TARGET_URL="$default_scheme://$input"
    fi
}

prepare_search_url() {
    local input=$1 query=$1 search_url=$GOOGLE_SEARCH_URL prefix_url encoded
    local prefix_pattern='^([A-Za-z0-9_]+)[[:space:]]+([^[:space:]].*)$'

    # 只有已知前缀后跟着非空白关键词时，才移除前缀。
    if [[ $input =~ $prefix_pattern ]]; then
        case ${BASH_REMATCH[1]} in
            g)    prefix_url=$GOOGLE_SEARCH_URL ;;
            bili) prefix_url='https://search.bilibili.com/all?keyword=' ;;
            yt)   prefix_url='https://www.youtube.com/results?search_query=' ;;
            b)    prefix_url='https://www.bing.com/search?q=' ;;
            gh)   prefix_url='https://github.com/search?q=' ;;
            *)    prefix_url='' ;;
        esac

        if [[ -n $prefix_url ]]; then
            search_url=$prefix_url
            query=${BASH_REMATCH[2]}
        fi
    fi

    # jq 缺失、失败或返回空值时，改用 Python 编码。
    if ! encoded=$(jq -rn --arg x "$query" '$x|@uri' 2>/dev/null) || [[ -z $encoded ]]; then
        if ! encoded=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' \
            "$query" 2>/dev/null) || [[ -z $encoded ]]; then
            printf '%s\n' 'fuzzel-web-search: 无法编码搜索词，请检查 jq 或 python3。' >&2
            return 1
        fi
    fi

    TARGET_URL="${search_url}${encoded}"
}

# 桌面应用按原始参数执行。
(( $# > 0 )) || exit 0
if [[ -n ${FUZZEL_DESKTOP_FILE_ID:-} || -n ${DESKTOP_ENTRY_ID:-} ]]; then
    exec -- "$@"
fi

input="$*"
[[ $input == *[![:space:]]* ]] || exit 0

prepare_web_url "$input" || prepare_search_url "$input" || exit 1

if ! command -v xdg-open >/dev/null 2>&1; then
    printf '%s\n' 'fuzzel-web-search: 找不到 xdg-open。' >&2
    exit 127
fi
exec xdg-open "$TARGET_URL"
