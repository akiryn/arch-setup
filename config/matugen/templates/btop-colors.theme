# Btop theme generated by Matugen

# 留空以沿用终端背景
theme[main_bg]=""

# 文字与标题
theme[main_fg]="{{colors.on_surface.default.hex}}"
theme[title]="{{colors.primary.default.hex}}"
theme[hi_fg]="{{colors.secondary.default.hex}}"
theme[inactive_fg]="{{colors.on_surface_variant.default.hex}}"

# 进程列表选中项
theme[selected_bg]="{{colors.primary.default.hex}}"
theme[selected_fg]="{{colors.on_primary.default.hex}}"

# 图表文字与进度条底色
theme[graph_text]="{{colors.on_surface.default.hex}}"
theme[meter_bg]="{{colors.surface_container_high.default.hex}}"

# 进程详情、迷你图表等
theme[proc_misc]="{{colors.tertiary.default.hex}}"

# 各区域边框与分隔线
theme[cpu_box]="{{colors.outline.default.hex}}"
theme[mem_box]="{{colors.outline.default.hex}}"
theme[net_box]="{{colors.outline.default.hex}}"
theme[proc_box]="{{colors.outline.default.hex}}"
theme[div_line]="{{colors.outline_variant.default.hex}}"

# 温度渐变
theme[temp_start]="{{colors.secondary.default.hex}}"
theme[temp_mid]="{{colors.primary.default.hex}}"
theme[temp_end]="{{colors.error.default.hex}}"

# CPU 使用率渐变
theme[cpu_start]="{{colors.secondary.default.hex}}"
theme[cpu_mid]="{{colors.primary.default.hex}}"
theme[cpu_end]="{{colors.error.default.hex}}"

# 内存与磁盘空闲量
theme[free_start]="{{colors.secondary_container.default.hex}}"
theme[free_mid]=""
theme[free_end]="{{colors.secondary.default.hex}}"

# 缓存
theme[cached_start]="{{colors.tertiary_container.default.hex}}"
theme[cached_mid]=""
theme[cached_end]="{{colors.tertiary.default.hex}}"

# 可用量
theme[available_start]="{{colors.primary_container.default.hex}}"
theme[available_mid]=""
theme[available_end]="{{colors.primary.default.hex}}"

# 已用量
theme[used_start]="{{colors.error_container.default.hex}}"
theme[used_mid]=""
theme[used_end]="{{colors.error.default.hex}}"

# 下载速率
theme[download_start]="{{colors.primary_container.default.hex}}"
theme[download_mid]=""
theme[download_end]="{{colors.primary.default.hex}}"

# 上传速率
theme[upload_start]="{{colors.tertiary_container.default.hex}}"
theme[upload_mid]=""
theme[upload_end]="{{colors.tertiary.default.hex}}"

# 进程列表中线程数、内存与 CPU 数值的渐变
theme[process_start]="{{colors.secondary.default.hex}}"
theme[process_mid]="{{colors.primary.default.hex}}"
theme[process_end]="{{colors.error.default.hex}}"
