{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",

  "logo": {
    "width": 25,
    "color": {
      "1": "{{colors.primary.default.hex}}",
      "2": "{{colors.primary.default.hex}}"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 2
    }
  },

  "display": {
    "separator": " ",
    "color": {
      "keys": "{{colors.primary.default.hex}}",
      "title": "{{colors.on_surface.default.hex}}",
      "output": "{{colors.on_surface.default.hex}}"
    }
  },

  "modules": [
    "break",

    // 系统信息
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "kernel",
      "key": " ├   KER "
    },
    {
      "type": "packages",
      "key": " ├   PAK ",
      "format": "{all}"
    },
    {
      "type": "command",
      "key": " ├   ROOT AGE ",
      "text": "created=$(stat -c %W / 2>/dev/null) || created=0; now=$(date +%s); if [ \"$created\" -gt 0 ] && [ \"$created\" -le \"$now\" ]; then printf '%s days\\n' \"$(( (now - created) / 86400 ))\"; else printf 'Unknown\\n'; fi"
    },
    {
      "type": "title",
      "key": " └   USR "
    },

    "break",
    "break",

    // 桌面与终端
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    {
      "type": "de",
      "key": " ├ 󱈹  DES ",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    {
      "type": "shell",
      "key": " ├   SHE ",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    {
      "type": "terminal",
      "key": " ├   TER ",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },
    {
      "type": "terminalfont",
      "key": " └   TFO ",
      "keyColor": "{{colors.tertiary.default.hex}}"
    },

    "break",
    "break",

    // 硬件信息
    {
      "type": "host",
      "key": "PC ",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "cpu",
      "key": " ├   CPU ",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "memory",
      "key": " ├   MEM ",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "swap",
      "key": " ├   SWP ",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "gpu",
      "key": " ├ 󰢮  GPU ",
      "format": "{vendor} {name}",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "display",
      "key": " ├   MON ",
      "format": "{name} {width}x{height}@{refresh-rate} Hz",
      "keyColor": "{{colors.secondary.default.hex}}"
    },
    {
      "type": "disk",
      "key": " └ 󰋊  DIS ",
      "keyColor": "{{colors.secondary.default.hex}}"
    },

    "break",
    "break",
    "colors"
  ]
}
