# Btop theme generated by Matugen

# 留空以沿用终端背景
theme[main_bg]=""

# 文字与标题
theme[main_fg]="#dee3e6"
theme[title]="#86d1ea"
theme[hi_fg]="#b3cad3"
theme[inactive_fg]="#bfc8cc"

# 进程列表选中项
theme[selected_bg]="#86d1ea"
theme[selected_fg]="#003642"

# 图表文字与进度条底色
theme[graph_text]="#dee3e6"
theme[meter_bg]="#252b2d"

# 进程详情、迷你图表等
theme[proc_misc]="#c1c4eb"

# 各区域边框与分隔线
theme[cpu_box]="#899296"
theme[mem_box]="#899296"
theme[net_box]="#899296"
theme[proc_box]="#899296"
theme[div_line]="#40484b"

# 温度渐变
theme[temp_start]="#b3cad3"
theme[temp_mid]="#86d1ea"
theme[temp_end]="#ffb4ab"

# CPU 使用率渐变
theme[cpu_start]="#b3cad3"
theme[cpu_mid]="#86d1ea"
theme[cpu_end]="#ffb4ab"

# 内存与磁盘空闲量
theme[free_start]="#344a52"
theme[free_mid]=""
theme[free_end]="#b3cad3"

# 缓存
theme[cached_start]="#414465"
theme[cached_mid]=""
theme[cached_end]="#c1c4eb"

# 可用量
theme[available_start]="#004e5f"
theme[available_mid]=""
theme[available_end]="#86d1ea"

# 已用量
theme[used_start]="#93000a"
theme[used_mid]=""
theme[used_end]="#ffb4ab"

# 下载速率
theme[download_start]="#004e5f"
theme[download_mid]=""
theme[download_end]="#86d1ea"

# 上传速率
theme[upload_start]="#414465"
theme[upload_mid]=""
theme[upload_end]="#c1c4eb"

# 进程列表中线程数、内存与 CPU 数值的渐变
theme[process_start]="#b3cad3"
theme[process_mid]="#86d1ea"
theme[process_end]="#ffb4ab"
